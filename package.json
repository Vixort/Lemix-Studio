{
  "name": "lemix-studio",
  "version": "0.2.0",
  "description": "An offline music and remix studio built with Electron and TypeScript",
  "author": "Lemix Studio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "electron .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "studio.lemix.app",
    "productName": "Lemix Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": ["node_modules/onnxruntime-node/**/*"],
    "win": {
      "target": "portable",
      "artifactName": "Lemix-Studio-${version}.exe"
    }
  },
  "dependencies": {
    "fft.js": "^4.0.4",
    "onnxruntime-node": "^1.31.1"
  }
}
